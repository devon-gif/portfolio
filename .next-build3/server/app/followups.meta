{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/followups/layout,_N_T_/followups/page,_N_T_/followups"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/followups/__PAGE__",
    "/followups",
    "/_index",
    "/_head"
  ]
}