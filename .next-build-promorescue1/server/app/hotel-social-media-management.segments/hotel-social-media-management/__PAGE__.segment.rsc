14:["$","p",null,{"className":"mt-5 text-[14px] text-[#A9A092]","children":["See more in our"," ",["$","$L3",null,{"href":"/case-studies","className":"text-[#E8D7A2] underline underline-offset-4 hover:text-[#F6F1E7]","children":"client case studies"}]," ","or compare"," ",["$","$L3",null,{"href":"/packages","className":"text-[#E8D7A2] underline underline-offset-4 hover:text-[#F6F1E7]","children":"monthly packages"}],"."]}]
15:["$","section","What's included each month",{"className":"mt-16 max-w-3xl","children":[["$","h2",null,{"className":"font-serif text-[clamp(22px,2.8vw,32px)] font-semibold","children":"What's included each month"}],["$","div",null,{"className":"mt-4 space-y-4 text-[15.5px] leading-relaxed text-[#A9A092]","children":[[["$","p","0",{"children":"Every month starts with a short creative plan matched to your calendar: what's coming up at the property, which seasonal pushes matter, what F&B or event promotion needs support. From there, we deliver finished assets on a steady cadence rather than a single end-of-month dump, so your feed never goes dark while you wait."}],["$","p","1",{"children":"A typical month includes a mix of:"}]],["$","ul",null,{"className":"list-disc space-y-2 pl-5 marker:text-[#C9A44C]","children":[["$","li","Feed graphics and carousels sized for Instagram and Facebook",{"children":"Feed graphics and carousels sized for Instagram and Facebook"}],["$","li","Short-form video (Reels and vertical cuts) built from your existing footage and photos",{"children":"Short-form video (Reels and vertical cuts) built from your existing footage and photos"}],["$","li","Stories assets for events, offers, and seasonal moments",{"children":"Stories assets for events, offers, and seasonal moments"}],["$","li","Captions written to match your property's voice, ready to paste",{"children":"Captions written to match your property's voice, ready to paste"}],["$","li","Event, F&B, and package promos timed to your calendar",{"children":"Event, F&B, and package promos timed to your calendar"}]]}]]}]]}]
16:["$","section","The approval-ready workflow",{"className":"mt-16 max-w-3xl","children":[["$","h2",null,{"className":"font-serif text-[clamp(22px,2.8vw,32px)] font-semibold","children":"The approval-ready workflow"}],["$","div",null,{"className":"mt-4 space-y-4 text-[15.5px] leading-relaxed text-[#A9A092]","children":[[["$","p","0",{"children":"Everything we send is built to pass review the first time: correct logo usage, brand colors, and, for flag properties like Hampton or Hotel Indigo, brand-standard awareness baked in from the start. Assets arrive labeled and organized, with captions attached, so whoever owns your scheduler can load a week of content in minutes."}],["$","p","1",{"children":"You keep final say on everything. We deliver, you approve, your team posts (or we hand off into whatever scheduling tool you already use). One round of feedback is part of the normal flow, and revisions are quick because we work from your brand files rather than guessing."}]],"$undefined"]}]]}]
17:["$","section","Who this works best for",{"className":"mt-16 max-w-3xl","children":[["$","h2",null,{"className":"font-serif text-[clamp(22px,2.8vw,32px)] font-semibold","children":"Who this works best for"}],["$","div",null,{"className":"mt-4 space-y-4 text-[15.5px] leading-relaxed text-[#A9A092]","children":[[["$","p","0",{"children":"Select-service and limited-service hotels where no one owns creative full time. Independent properties where the marketing lead is stretched across PR, groups, and OTA management. And multi-property groups or management companies who need consistent output across locations without putting a creative hire in every building."}],["$","p","1",{"children":"If your property posts inconsistently, recycles the same four photos, or goes quiet during your busiest season precisely because everyone is too busy to post, that's the exact situation this service was built for."}]],"$undefined"]}]]}]
18:["$","section","What it costs compared with hiring",{"className":"mt-16 max-w-3xl","children":[["$","h2",null,{"className":"font-serif text-[clamp(22px,2.8vw,32px)] font-semibold","children":"What it costs compared with hiring"}],["$","div",null,{"className":"mt-4 space-y-4 text-[15.5px] leading-relaxed text-[#A9A092]","children":[[["$","p","0",{"children":"A dedicated in-house social media or creative hire typically runs $90K–$180K a year once you count salary, benefits, payroll taxes, software, recruiting, and the management time to keep them busy and on-brand. Most hotels can't justify that for one property, which is why the work lands on someone who already has a full-time job."}],["$","p","1",{"children":"Archer Design delivers the monthly output of that role for a fixed fee, with no employment overhead and no replacement risk if someone leaves. You can see the math on our hotel marketing cost savings page, or compare monthly tiers on the packages page."}]],"$undefined"]}]]}]
19:["$","section","How to start",{"className":"mt-16 max-w-3xl","children":[["$","h2",null,{"className":"font-serif text-[clamp(22px,2.8vw,32px)] font-semibold","children":"How to start"}],["$","div",null,{"className":"mt-4 space-y-4 text-[15.5px] leading-relaxed text-[#A9A092]","children":[[["$","p","0",{"children":"Start with the free trial: send your existing property photos, a menu, or an upcoming event, and we'll return 5 finished, approval-ready assets within 7 days. No card, no contract. You judge the quality on your own brand, not a portfolio. If it's useful, pick a monthly package. If not, you keep the assets and we part ways friendly."}]],"$undefined"]}]]}]
