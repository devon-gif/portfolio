
/*
  Safe CSS-only Revstudio light treatment.
  Background image: /revstudio/media/new%20background.png
*/

.revstudio-light-shell {
  min-height: 100vh;
  overflow-x: hidden;

  background-color: #ffffff !important;

  background-image:
    linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.91) 0%,
      rgba(255, 255, 255, 0.86) 42%,
      rgba(249, 246, 255, 0.91) 100%
    ),
    url("/revstudio/media/new%20background.png");

  background-position:
    center top,
    center top;

  background-size:
    cover,
    cover;

  background-repeat:
    no-repeat,
    no-repeat;

  background-attachment:
    fixed,
    fixed;

  color: #19151e;
}

/*
  Remove only the old page-level dark background.
  This does not change visibility, opacity, positioning,
  animation, or React-rendered content.
*/
.revstudio-light-shell > div,
.revstudio-light-shell main {
  background-color: transparent !important;
  background-image: none !important;
}

/* White navigation */
.revstudio-light-shell header,
.revstudio-light-shell nav {
  background:
    rgba(255, 255, 255, 0.96)
    !important;

  border-color:
    rgba(91, 33, 245, 0.12)
    !important;

  color: #201a26 !important;

  box-shadow:
    0 1px 0 rgba(49, 26, 72, 0.07),
    0 12px 34px rgba(40, 18, 65, 0.035);

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.revstudio-light-shell header a,
.revstudio-light-shell nav a {
  color: #423b48 !important;
}

.revstudio-light-shell header a:hover,
.revstudio-light-shell nav a:hover {
  color: #5b21f5 !important;
}

/*
  Main page sections become translucent white panels,
  allowing the background artwork to show through softly.
*/
.revstudio-light-shell main > section {
  background:
    rgba(255, 255, 255, 0.86)
    !important;

  border-color:
    rgba(91, 33, 245, 0.1)
    !important;

  color: #19151e !important;

  backdrop-filter:
    blur(8px);

  -webkit-backdrop-filter:
    blur(8px);
}

.revstudio-light-shell main > section:nth-of-type(even) {
  background:
    rgba(248, 245, 255, 0.88)
    !important;
}

/* Restore readable dark typography on light sections. */
.revstudio-light-shell main > section
  :is(h1, h2, h3, h4, h5, h6) {
  color: #19151e !important;
  text-shadow: none !important;
}

.revstudio-light-shell main > section > div > p,
.revstudio-light-shell main > section > p {
  color: #615968 !important;
}

/* Revstudio purple for editorial accents. */
.revstudio-light-shell
  :is(h1, h2, h3)
  :is(em, span[class*="purple"], span[class*="violet"]) {
  color: #5b21f5 !important;
}

.revstudio-light-shell
  [class*="uppercase"][class*="tracking"] {
  color: #5b21f5 !important;
}

/*
  Preserve intentionally dark cards, media panels,
  videos and creative showcase areas.
*/
.revstudio-light-shell
  :is(article, aside, div)[class*="bg-black"],
.revstudio-light-shell
  :is(article, aside, div)[class*="bg-[#0"],
.revstudio-light-shell
  :is(article, aside, div)[class*="bg-neutral-9"],
.revstudio-light-shell
  :is(article, aside, div)[class*="bg-zinc-9"] {
  background-color: #180b27 !important;
}

/* Strong purple CTA */
.revstudio-light-shell
  :is(a, button)[class*="bg-purple"],
.revstudio-light-shell
  :is(a, button)[class*="bg-violet"] {
  border-color: #7446ff !important;

  background:
    linear-gradient(
      145deg,
      #8258ff,
      #5b21f5 50%,
      #3b0fac
    ) !important;

  color: #ffffff !important;

  box-shadow:
    0 5px 0 #2c087d,
    0 15px 34px rgba(91, 33, 245, 0.28),
    inset 0 1px 0 rgba(255, 255, 255, 0.42)
    !important;
}

@media (max-width: 800px) {
  .revstudio-light-shell {
    background-attachment:
      scroll,
      scroll;

    background-position:
      center top,
      62% top;
  }

  .revstudio-light-shell main > section {
    background:
      rgba(255, 255, 255, 0.92)
      !important;
  }
}

/* REVSTUDIO LIGHT TEXT CONTRAST */

/*
  Strong, readable text throughout the white and lavender sections.
  This overrides faded text-white, muted-gray and opacity utilities
  inherited from the original dark design.
*/
.revstudio-light-shell main > section
  :is(h1, h2, h3, h4, h5, h6) {
  color: #18131d !important;
  opacity: 1 !important;
  text-shadow: none !important;
}

.revstudio-light-shell main > section
  :is(p, li, dt, dd, figcaption) {
  color: #574f5d !important;
  opacity: 1 !important;
}

.revstudio-light-shell main > section
  :is(
    span,
    small,
    strong,
    em,
    label,
    blockquote
  ) {
  opacity: 1 !important;
}

/* Override Tailwind text colors that were intended for a black page. */
.revstudio-light-shell main > section
  [class*="text-white"],
.revstudio-light-shell main > section
  [class*="text-gray"],
.revstudio-light-shell main > section
  [class*="text-neutral"],
.revstudio-light-shell main > section
  [class*="text-zinc"],
.revstudio-light-shell main > section
  [class*="text-slate"],
.revstudio-light-shell main > section
  [class*="text-stone"] {
  color: #574f5d !important;
  opacity: 1 !important;
}

/* Large headings and metric numbers should be nearly black. */
.revstudio-light-shell main > section
  :is(
    [class*="text-3xl"],
    [class*="text-4xl"],
    [class*="text-5xl"],
    [class*="text-6xl"],
    [class*="text-7xl"]
  ) {
  color: #18131d !important;
  opacity: 1 !important;
}

/* Eyebrows, section labels and editorial accents use her purple. */
.revstudio-light-shell main > section
  :is(
    [class*="uppercase"],
    [class*="tracking"]
  ) {
  color: #5b21f5 !important;
  opacity: 1 !important;
}

/* Secondary links and outline buttons on the light background. */
.revstudio-light-shell main > section
  a:not([class*="bg-"]),
.revstudio-light-shell main > section
  button:not([class*="bg-"]) {
  color: #312838 !important;
  opacity: 1 !important;
}

/* Purple CTA buttons remain white and highly legible. */
.revstudio-light-shell
  :is(a, button)[class*="bg-purple"],
.revstudio-light-shell
  :is(a, button)[class*="bg-violet"],
.revstudio-light-shell
  :is(a, button)[style*="background"] {
  color: #ffffff !important;
  opacity: 1 !important;
}

.revstudio-light-shell
  :is(a, button)[class*="bg-purple"] *,
.revstudio-light-shell
  :is(a, button)[class*="bg-violet"] *,
.revstudio-light-shell
  :is(a, button)[style*="background"] * {
  color: #ffffff !important;
  opacity: 1 !important;
}

/*
  Restore light text inside intentionally dark information cards.
*/
.revstudio-light-shell
  :is(
    article,
    aside,
    div
  )[class*="bg-black"]
  :is(h1, h2, h3, h4, h5, h6, strong),
.revstudio-light-shell
  :is(
    article,
    aside,
    div
  )[class*="bg-[#0"]
  :is(h1, h2, h3, h4, h5, h6, strong),
.revstudio-light-shell
  :is(
    article,
    aside,
    div
  )[class*="bg-neutral-9"]
  :is(h1, h2, h3, h4, h5, h6, strong),
.revstudio-light-shell
  :is(
    article,
    aside,
    div
  )[class*="bg-zinc-9"]
  :is(h1, h2, h3, h4, h5, h6, strong) {
  color: #ffffff !important;
  opacity: 1 !important;
}

.revstudio-light-shell
  :is(
    article,
    aside,
    div
  )[class*="bg-black"]
  :is(p, span, small, li, em),
.revstudio-light-shell
  :is(
    article,
    aside,
    div
  )[class*="bg-[#0"]
  :is(p, span, small, li, em),
.revstudio-light-shell
  :is(
    article,
    aside,
    div
  )[class*="bg-neutral-9"]
  :is(p, span, small, li, em),
.revstudio-light-shell
  :is(
    article,
    aside,
    div
  )[class*="bg-zinc-9"]
  :is(p, span, small, li, em) {
  color: rgba(255, 255, 255, 0.78) !important;
  opacity: 1 !important;
}

/* Preserve white overlay captions placed directly over imagery or video. */
.revstudio-light-shell
  :is(figure, picture, div):has(> img)
  :is(h1, h2, h3, h4, h5, h6, p, span, small),
.revstudio-light-shell
  :is(figure, picture, div):has(> video)
  :is(h1, h2, h3, h4, h5, h6, p, span, small) {
  color: #ffffff !important;
  opacity: 1 !important;
  text-shadow:
    0 2px 12px rgba(0, 0, 0, 0.72) !important;
}

/* The hero title gets the strongest contrast. */
.revstudio-light-shell main > section:first-of-type h1 {
  color: #17121b !important;
  opacity: 1 !important;
}

.revstudio-light-shell main > section:first-of-type h1
  :is(span, em) {
  color: #5b21f5 !important;
}

/* Hero description and supporting details. */
.revstudio-light-shell main > section:first-of-type
  :is(p, small) {
  color: #554c5b !important;
  opacity: 1 !important;
}

/* Brand-strip explanatory text should remain visible. */
.revstudio-light-shell main > section:first-of-type
  [class*="tracking"] {
  color: #5b21f5 !important;
}

.revstudio-light-shell main > section:first-of-type
  figcaption,
.revstudio-light-shell main > section:first-of-type
  [class*="text-xs"] {
  color: #655d6b !important;
  opacity: 1 !important;
}

/* END REVSTUDIO LIGHT TEXT CONTRAST */

/* REVSTUDIO TRS BRAND CONTRAST */

.revstudio-light-shell {
  --trs-purple: #5b21f5;
  --trs-purple-bright: #7547ff;
  --trs-purple-dark: #35109b;
  --trs-ink: #28242d;
  --trs-body: #5a5560;
  --trs-panel: #170d20;
  --trs-panel-2: #27113d;
}

/* Brand purple throughout the page */
.revstudio-light-shell
  :is(
    [class*="text-purple"],
    [class*="text-violet"],
    [class*="text-fuchsia"]
  ) {
  color: var(--trs-purple) !important;
}

.revstudio-light-shell
  :is(
    [class*="bg-purple"],
    [class*="bg-violet"],
    [class*="bg-fuchsia"]
  ) {
  background-color: var(--trs-purple) !important;
}

.revstudio-light-shell
  :is(
    [class*="border-purple"],
    [class*="border-violet"],
    [class*="border-fuchsia"]
  ) {
  border-color: var(--trs-purple) !important;
}

/*
  Every normal piece of text over white or lavender becomes dark.
  This is deliberately broader than the previous patch so original
  white-text utility classes cannot make the page unreadable.
*/
.revstudio-light-shell main {
  color: var(--trs-ink) !important;
}

.revstudio-light-shell main
  :is(
    h1,
    h2,
    h3,
    h4,
    h5,
    h6,
    p,
    span,
    small,
    strong,
    em,
    li,
    dt,
    dd,
    label,
    figcaption,
    blockquote
  ) {
  color: var(--trs-body) !important;
  opacity: 1 !important;
  text-shadow: none !important;
}

.revstudio-light-shell main
  :is(h1, h2, h3, h4, h5, h6, strong) {
  color: var(--trs-ink) !important;
}

.revstudio-light-shell main
  :is(
    [class*="text-white"],
    [class*="text-gray"],
    [class*="text-neutral"],
    [class*="text-zinc"],
    [class*="text-slate"],
    [class*="text-stone"],
    [class*="opacity-"]
  ) {
  color: var(--trs-body) !important;
  opacity: 1 !important;
}

/* Section labels and highlighted wording */
.revstudio-light-shell main
  :is(
    [class*="uppercase"],
    [class*="tracking"]
  ) {
  color: var(--trs-purple) !important;
  opacity: 1 !important;
}

.revstudio-light-shell main
  :is(h1, h2, h3)
  :is(em, span) {
  opacity: 1 !important;
}

.revstudio-light-shell main
  :is(h1, h2, h3)
  :is(
    [class*="purple"],
    [class*="violet"],
    em
  ) {
  color: var(--trs-purple) !important;
}

/*
  Turn the original gray glass cards into deep black-purple panels.
  Selectors are limited to rounded information containers with text;
  media cards containing images or videos are excluded.
*/
.revstudio-light-shell main
  :is(article, aside, div)
  [class*="rounded-"][class*="bg-black"]:not(:has(img, video, picture)),
.revstudio-light-shell main
  :is(article, aside, div)
  [class*="rounded-"][class*="bg-[#0"]:not(:has(img, video, picture)),
.revstudio-light-shell main
  :is(article, aside, div)
  [class*="rounded-"][class*="bg-[#1"]:not(:has(img, video, picture)),
.revstudio-light-shell main
  :is(article, aside, div)
  [class*="rounded-"][class*="bg-[#2"]:not(:has(img, video, picture)),
.revstudio-light-shell main
  :is(article, aside, div)
  [class*="rounded-"][class*="bg-[#3"]:not(:has(img, video, picture)),
.revstudio-light-shell main
  :is(article, aside, div)
  [class*="rounded-"][class*="bg-neutral"]:not(:has(img, video, picture)),
.revstudio-light-shell main
  :is(article, aside, div)
  [class*="rounded-"][class*="bg-zinc"]:not(:has(img, video, picture)),
.revstudio-light-shell main
  :is(article, aside, div)
  [class*="rounded-"][class*="bg-slate"]:not(:has(img, video, picture)),
.revstudio-light-shell main
  :is(article, aside, div)
  [class*="rounded-"][class*="bg-white/"]:not(:has(img, video, picture)),
.revstudio-light-shell main
  :is(article, aside, div)
  [class*="rounded-"][class*="border-white"]:has(p):not(:has(img, video, picture)) {
  position: relative !important;
  overflow: hidden !important;

  border:
    1px solid rgba(132, 86, 255, 0.34)
    !important;

  background:
    radial-gradient(
      circle at 12% 0%,
      rgba(91, 33, 245, 0.3),
      transparent 38%
    ),
    radial-gradient(
      circle at 94% 100%,
      rgba(103, 43, 192, 0.25),
      transparent 42%
    ),
    linear-gradient(
      135deg,
      var(--trs-panel),
      var(--trs-panel-2)
    ) !important;

  background-color:
    var(--trs-panel) !important;

  box-shadow:
    0 24px 60px rgba(28, 8, 47, 0.22),
    0 7px 22px rgba(91, 33, 245, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 0.12)
    !important;

  backdrop-filter:
    blur(20px) saturate(135%);

  -webkit-backdrop-filter:
    blur(20px) saturate(135%);

  color: #ffffff !important;
}

/* All text within dark blocks becomes readable */
.revstudio-light-shell main
  :is(article, aside, div)
  [class*="rounded-"][class*="bg-black"]:not(:has(img, video, picture))
  :is(h1, h2, h3, h4, h5, h6, p, span, small, strong, em, li, label),
.revstudio-light-shell main
  :is(article, aside, div)
  [class*="rounded-"][class*="bg-[#"]:not(:has(img, video, picture))
  :is(h1, h2, h3, h4, h5, h6, p, span, small, strong, em, li, label),
.revstudio-light-shell main
  :is(article, aside, div)
  [class*="rounded-"][class*="bg-neutral"]:not(:has(img, video, picture))
  :is(h1, h2, h3, h4, h5, h6, p, span, small, strong, em, li, label),
.revstudio-light-shell main
  :is(article, aside, div)
  [class*="rounded-"][class*="bg-zinc"]:not(:has(img, video, picture))
  :is(h1, h2, h3, h4, h5, h6, p, span, small, strong, em, li, label),
.revstudio-light-shell main
  :is(article, aside, div)
  [class*="rounded-"][class*="bg-slate"]:not(:has(img, video, picture))
  :is(h1, h2, h3, h4, h5, h6, p, span, small, strong, em, li, label),
.revstudio-light-shell main
  :is(article, aside, div)
  [class*="rounded-"][class*="bg-white/"]:not(:has(img, video, picture))
  :is(h1, h2, h3, h4, h5, h6, p, span, small, strong, em, li, label),
.revstudio-light-shell main
  :is(article, aside, div)
  [class*="rounded-"][class*="border-white"]:has(p):not(:has(img, video, picture))
  :is(h1, h2, h3, h4, h5, h6, p, span, small, strong, em, li, label) {
  color: rgba(255, 255, 255, 0.82) !important;
  opacity: 1 !important;
  text-shadow: none !important;
}

.revstudio-light-shell main
  :is(article, aside, div)
  [class*="rounded-"][class*="bg-black"]:not(:has(img, video, picture))
  :is(h1, h2, h3, h4, h5, h6, strong),
.revstudio-light-shell main
  :is(article, aside, div)
  [class*="rounded-"][class*="bg-[#"]:not(:has(img, video, picture))
  :is(h1, h2, h3, h4, h5, h6, strong),
.revstudio-light-shell main
  :is(article, aside, div)
  [class*="rounded-"][class*="bg-white/"]:not(:has(img, video, picture))
  :is(h1, h2, h3, h4, h5, h6, strong),
.revstudio-light-shell main
  :is(article, aside, div)
  [class*="rounded-"][class*="border-white"]:has(p):not(:has(img, video, picture))
  :is(h1, h2, h3, h4, h5, h6, strong) {
  color: #ffffff !important;
}

/* Purple labels inside dark blocks */
.revstudio-light-shell main
  :is(article, aside, div)
  [class*="rounded-"]
  :is(
    [class*="uppercase"],
    [class*="tracking"]
  ) {
  color: #bda4ff !important;
  opacity: 1 !important;
}

/* Preserve white captions placed directly over visual media */
.revstudio-light-shell
  :is(figure, picture, div):has(> img)
  :is(h1, h2, h3, h4, h5, h6, p, span, small),
.revstudio-light-shell
  :is(figure, picture, div):has(> video)
  :is(h1, h2, h3, h4, h5, h6, p, span, small) {
  color: #ffffff !important;
