# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# temp build dir from verification (sandbox FS could not remove)
.next-verify/
.next-verify2/
.next-verify3/
.next-verify4/
.next-verify5/
.next-verify6/
.next-verify7/
.next-verify8/
.next-verify9/
.next-verify10/
.next-verify11/
.next-verify12/
.next-verify13/

# Local env / secrets
.env.local
.env*.local

# Next build artifacts
.next/
.next_stale_*/

# Python/venv
.venv/

# Large local video assets - host externally later
public/videos/

