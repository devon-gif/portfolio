1b:["$","section","Who we support",{"className":"mt-16 max-w-3xl","children":[["$","h2",null,{"className":"font-serif text-[clamp(22px,2.8vw,32px)] font-semibold","children":"Who we support"}],["$","div",null,{"className":"mt-4 space-y-4 text-[15.5px] leading-relaxed text-[#A9A092]","children":[[["$","p","0",{"children":"Our clients run the spread of hospitality: select-service hotels (Hampton, Hotel Indigo, and similar flags) where no one owns creative on property; independent hotels and resorts with seasonal campaign needs; hotel restaurants and standalone F&B that need a steady stream of menu and special content; spas and wellness studios that want a calm, premium feel without a designer on staff; and wedding and event venues that need promo creative to keep the calendar full."}],["$","p","1",{"children":"We also work at the group level: management companies and multi-property portfolios that need brand-consistent output across locations on one plan and one invoice, instead of a creative hire in every building."}]],"$undefined"]}]]}]
1c:["$","section","What creative support actually includes",{"className":"mt-16 max-w-3xl","children":[["$","h2",null,{"className":"font-serif text-[clamp(22px,2.8vw,32px)] font-semibold","children":"What creative support actually includes"}],["$","div",null,{"className":"mt-4 space-y-4 text-[15.5px] leading-relaxed text-[#A9A092]","children":[[["$","p","0",{"children":"The monthly deliverable mix flexes with your calendar, but the core menu is:"}]],["$","ul",null,{"className":"list-disc space-y-2 pl-5 marker:text-[#C9A44C]","children":[["$","li","Social graphics: feed posts, carousels, and stories for Instagram and Facebook",{"children":"Social graphics: feed posts, carousels, and stories for Instagram and Facebook"}],["$","li","Short-form video: Reels and vertical cuts built from existing footage and stills",{"children":"Short-form video: Reels and vertical cuts built from existing footage and stills"}],["$","li","Captions and campaign copy written in your property's voice",{"children":"Captions and campaign copy written in your property's voice"}],["$","li","Event, wedding, and F&B promo assets timed to what's coming up",{"children":"Event, wedding, and F&B promo assets timed to what's coming up"}],["$","li","Seasonal campaign visuals, launches, holidays, local moments",{"children":"Seasonal campaign visuals, launches, holidays, local moments"}],["$","li","Branded collateral for offers, partnerships, and on-property screens",{"children":"Branded collateral for offers, partnerships, and on-property screens"}]]}]]}]]}]
1d:["$","section","How the workload actually drops",{"className":"mt-16 max-w-3xl","children":[["$","h2",null,{"className":"font-serif text-[clamp(22px,2.8vw,32px)] font-semibold","children":"How the workload actually drops"}],["$","div",null,{"className":"mt-4 space-y-4 text-[15.5px] leading-relaxed text-[#A9A092]","children":[[["$","p","0",{"children":"The point isn't just prettier posts. It's hours back. Today, your GM or marketing lead is finding photos, fighting with a design tool, writing captions at 9pm, and still feeling behind. With a creative partner in place, their job shrinks to two steps: forward us what's happening (an event sheet, a menu, a few photos) and approve what comes back."}],["$","p","1",{"children":"Because everything arrives finished and labeled with captions attached, scheduling a full week of content takes minutes. The approval-ready workflow is the difference between creative support that saves time and creative support that creates a new management job."}]],"$undefined"]}]]}]
1e:["$","section","Why not an agency or a freelancer?",{"className":"mt-16 max-w-3xl","children":[["$","h2",null,{"className":"font-serif text-[clamp(22px,2.8vw,32px)] font-semibold","children":"Why not an agency or a freelancer?"}],["$","div",null,{"className":"mt-4 space-y-4 text-[15.5px] leading-relaxed text-[#A9A092]","children":[[["$","p","0",{"children":"Agencies are built for brands with budgets to match, strategy decks, account managers, and retainers that start where most single properties' entire marketing budget ends. Freelancers are affordable but fragile: quality varies, availability changes, and every new person re-learns your brand from zero."}],["$","p","1",{"children":"A dedicated outside partner sits in between: senior-level consistency and hospitality-specific instincts, at a fixed monthly cost a single property can justify. Across tracked hotel, restaurant, event, and wellness campaigns, Archer Design creative has helped generate 14.8M+ impressions, 565K+ direct engagements, 4.3M+ reach, and 670K+ reported post clicks. See the case studies for what that looks like property by property."}]],"$undefined"]}]]}]
1f:["$","section","Getting started is deliberately easy",{"className":"mt-16 max-w-3xl","children":[["$","h2",null,{"className":"font-serif text-[clamp(22px,2.8vw,32px)] font-semibold","children":"Getting started is deliberately easy"}],["$","div",null,{"className":"mt-4 space-y-4 text-[15.5px] leading-relaxed text-[#A9A092]","children":[[["$","p","0",{"children":"Send your existing photos, menus, or event details and we'll build 5 finished assets in 7 days, free, no card, no contract. You judge the quality on your own brand. If it's a fit, choose a monthly package; if your needs span several properties, we'll scope a group partnership. Either way, you'll know within a week whether this solves your bandwidth problem."}]],"$undefined"]}]]}]
20:["$","section",null,{"className":"mt-20 max-w-3xl","aria-label":"Frequently asked questions","children":[["$","span",null,{"className":"text-[12px] font-semibold uppercase tracking-[0.3em] text-[#C9A44C]","children":"FAQ"}],["$","h2",null,{"className":"mt-3 font-serif text-[clamp(24px,3vw,36px)] font-semibold","children":"Questions hotel teams actually ask."}],["$","div",null,{"className":"mt-6 divide-y divide-[rgba(201,164,76,0.18)]","children":[["$","details","Is this an agency?",{"open":true,"className":"group py-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center justify-between gap-4 font-serif text-lg text-[#F6F1E7] [&::-webkit-details-marker]:hidden","children":["Is this an agency?",["$","span",null,{"className":"text-2xl text-[#C9A44C] transition group-open:rotate-45","aria-hidden":true,"children":"+"}]]}],["$","p",null,{"className":"mt-3 text-[15px] leading-relaxed text-[#A9A092]","children":"No. There's no account team, no strategy retainer, no minimum scoped for a brand ten times your size. It's a dedicated outside creative partner who plugs into your existing team and delivers finished content every month."}]]}],["$","details","We're a restaurant / spa / venue, not a hotel. Does this still apply?",{"open":false,"className":"group py-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center justify-between gap-4 font-serif text-lg text-[#F6F1E7] [&::-webkit-details-marker]:hidden","children":["We're a restaurant / spa / venue, not a hotel. Does this still apply?",["$","span",null,{"className":"text-2xl text-[#C9A44C] transition group-open:rotate-45","aria-hidden":true,"children":"+"}]]}],["$","p",null,{"className":"mt-3 text-[15px] leading-relaxed text-[#A9A092]","children":"Yes. Hotels are our anchor, but the same model covers hotel restaurants, standalone F&B, spas and wellness studios, and wedding and event venues. The deliverables shift to match, menu features, treatment promos, event creative, but the workflow is identical."}]]}],["$","details","What do you need from us each month?",{"open":false,"className":"group py-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center justify-between gap-4 font-serif text-lg text-[#F6F1E7] [&::-webkit-details-marker]:hidden","children":["What do you need from us each month?",["$","span",null,{"className":"text-2xl text-[#C9A44C] transition group-open:rotate-45","aria-hidden":true,"children":"+"}]]}],["$","p",null,{"className":"mt-3 text-[15px] leading-relaxed text-[#A9A092]","children":"Surprisingly little: whatever's coming up (events, menu changes, offers) and any new photos you have. We handle planning, design, motion, and captions from there. Most clients spend under an hour a month on the whole relationship."}]]}],["$","details","Can you keep multiple properties consistent?",{"open":false,"className":"group py-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center justify-between gap-4 font-serif text-lg text-[#F6F1E7] [&::-webkit-details-marker]:hidden","children":["Can you keep multiple properties consistent?",["$","span",null,{"className":"text-2xl text-[#C9A44C] transition group-open:rotate-45","aria-hidden":true,"children":"+"}]]}],["$","p",null,{"className":"mt-3 text-[15px] leading-relaxed text-[#A9A092]","children":"Yes, that's a core use case. Group-level brand consistency with property-level customization, one plan, one invoice. Groups of 5+ properties get custom scoping."}]]}],["$","details","What does it cost?",{"open":false,"className":"group py-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center justify-between gap-4 font-serif text-lg text-[#F6F1E7] [&::-webkit-details-marker]:hidden","children":["What does it cost?","$L2c"]}],"$L2d"]}]]}]]}]
