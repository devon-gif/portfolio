14:["$","p",null,{"className":"mt-5 text-[14px] text-[#A9A092]","children":["See more in our"," ",["$","$L3",null,{"href":"/case-studies","className":"text-[#E8D7A2] underline underline-offset-4 hover:text-[#F6F1E7]","children":"client case studies"}]," ","or compare"," ",["$","$L3",null,{"href":"/packages","className":"text-[#E8D7A2] underline underline-offset-4 hover:text-[#F6F1E7]","children":"monthly packages"}],"."]}]
15:["$","section","What hotel video marketing covers",{"className":"mt-16 max-w-3xl","children":[["$","h2",null,{"className":"font-serif text-[clamp(22px,2.8vw,32px)] font-semibold","children":"What hotel video marketing covers"}],["$","div",null,{"className":"mt-4 space-y-4 text-[15.5px] leading-relaxed text-[#A9A092]","children":[[["$","p","0",{"children":"Each month we look at your calendar and build video where it earns its keep. That usually means a mix of always-on property content (rooms, lobby, pool, views), revenue-driving promos (restaurant specials, spa offers, packages), and time-boxed moments (weddings, holidays, local events)."}],["$","p","1",{"children":"Typical deliverables include:"}]],["$","ul",null,{"className":"list-disc space-y-2 pl-5 marker:text-[#C9A44C]","children":[["$","li","Vertical Reels and TikTok-format cuts sized 9:16",{"children":"Vertical Reels and TikTok-format cuts sized 9:16"}],["$","li","Room, suite, and amenity showcase videos",{"children":"Room, suite, and amenity showcase videos"}],["$","li","F&B and bar motion content for specials and seasonal menus",{"children":"F&B and bar motion content for specials and seasonal menus"}],["$","li","Event and wedding promo spots that fill the calendar",{"children":"Event and wedding promo spots that fill the calendar"}],["$","li","Seasonal transitions and campaign openers built from stills",{"children":"Seasonal transitions and campaign openers built from stills"}],["$","li","Captions and on-screen text written to match your voice",{"children":"Captions and on-screen text written to match your voice"}]]}]]}]]}]
16:["$","section","No shoot? Not a problem.",{"className":"mt-16 max-w-3xl","children":[["$","h2",null,{"className":"font-serif text-[clamp(22px,2.8vw,32px)] font-semibold","children":"No shoot? Not a problem."}],["$","div",null,{"className":"mt-4 space-y-4 text-[15.5px] leading-relaxed text-[#A9A092]","children":[[["$","p","0",{"children":"The biggest myth in hotel video is that you need fresh footage to start. Most properties are sitting on years of photography that has never been used as motion. We animate stills into cinematic timelapses, build transitions between seasons, and combine photo sets into moving sequences that read as video on a phone screen."}],["$","p","1",{"children":"When you do have real footage (a past brand shoot, drone passes, or event clips), we cut it into multiple short-form pieces rather than letting it sit in a folder. One good 3-minute property video can become eight Reels."}]],"$undefined"]}]]}]
17:["$","section","Built for how hotels actually approve content",{"className":"mt-16 max-w-3xl","children":[["$","h2",null,{"className":"font-serif text-[clamp(22px,2.8vw,32px)] font-semibold","children":"Built for how hotels actually approve content"}],["$","div",null,{"className":"mt-4 space-y-4 text-[15.5px] leading-relaxed text-[#A9A092]","children":[[["$","p","0",{"children":"Every video arrives finished and labeled, with caption copy attached, sized for the platform it's going to. Flag properties get brand-standard-aware editing, logo treatment, typography, and tone that won't bounce off a brand review. You review, approve, and schedule; we handle revisions quickly because we're working from your brand files."}],["$","p","1",{"children":"If you already work with us on social media management, video slots into the same monthly plan and the same approval flow: one partner, one invoice."}]],"$undefined"]}]]}]
18:["$","section","The cost case",{"className":"mt-16 max-w-3xl","children":[["$","h2",null,{"className":"font-serif text-[clamp(22px,2.8vw,32px)] font-semibold","children":"The cost case"}],["$","div",null,{"className":"mt-4 space-y-4 text-[15.5px] leading-relaxed text-[#A9A092]","children":[[["$","p","0",{"children":"A freelance videographer day runs real money before editing even starts, and an in-house content hire who can shoot and edit is a $90K+ commitment with benefits and management overhead on top. For a single property posting 3–5 videos a month, neither math works."}],["$","p","1",{"children":"Because we build from existing assets, you pay a fixed monthly fee for finished video as part of your creative package. See the cost savings breakdown or compare packages for current tiers."}]],"$undefined"]}]]}]
19:["$","section","Start with a free sample",{"className":"mt-16 max-w-3xl","children":[["$","h2",null,{"className":"font-serif text-[clamp(22px,2.8vw,32px)] font-semibold","children":"Start with a free sample"}],["$","div",null,{"className":"mt-4 space-y-4 text-[15.5px] leading-relaxed text-[#A9A092]","children":[[["$","p","0",{"children":"Send us a handful of property photos or a clip you already have, and we'll include short-form motion in your free 5-asset trial so you can see exactly how your property looks in movement. Five finished pieces, 7 days, no card. If the quality earns the budget, we go monthly."}]],"$undefined"]}]]}]
